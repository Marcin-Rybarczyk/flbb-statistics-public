FLASK_ENV=production
DEBUG=False
# Add your environment variables here

# Authentication Configuration
# Admin credentials (required for admin access)
# Default admin username is 'admin' with password 'admin' if not set
# To set a custom admin password, use the hash of your password:
# python3 -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Regular user credentials (optional, comma-separated)
# Format: username1:password_hash1,username2:password_hash2
# To generate password hash:
# python3 -c "import hashlib; print(hashlib.sha256('password'.encode()).hexdigest())"
#USER_CREDENTIALS=user1:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8

# Session secret key (required for production)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
#SECRET_KEY=your-secret-key-here

# Google Drive Integration (Optional)
# GOOGLE_DRIVE_CREDENTIALS=path/to/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# MongoDB Configuration (Optional)
# Enable MongoDB storage for extracted JSON data
# MONGODB_ENABLED=false
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=flbb-statistics
# MongoDB Atlas example (cloud MongoDB):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MyDevil.net statistics tracking code (optional)
# To enable www statistics in MyDevil panel:
# 1. Log in to your MyDevil.net control panel
# 2. Go to WWW → Statistics
# 3. Enable statistics for your website
# 4. Copy the provided tracking code snippet
# 5. Set MYDEVIL_STATS_CODE to the complete HTML/JavaScript code
# Example: MYDEVIL_STATS_CODE='<script>/* your tracking code here */</script>'
#MYDEVIL_STATS_CODE=
