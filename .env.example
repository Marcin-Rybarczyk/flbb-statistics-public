FLASK_ENV=production
DEBUG=False
# Add your environment variables here

# Google Drive Integration (Optional)
# GOOGLE_DRIVE_CREDENTIALS=path/to/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# MongoDB Configuration (Optional)
# Enable MongoDB storage for extracted JSON data
# MONGODB_ENABLED=false
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=flbb-statistics

# MongoDB Atlas example (cloud MongoDB):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MyDevil.net MongoDB Configuration (via SSH tunnel):
# MyDevil.net provides MongoDB on their servers, accessible via SSH tunnel
# Step 1: Create SSH tunnel (run this in a separate terminal):
#   ssh -L 27017:localhost:27017 username@server.mydevil.net
# Step 2: Configure environment variables:
# MONGODB_ENABLED=true
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=flbb-statistics
# Note: Keep the SSH tunnel running while the Flask app is active

# Data Source Configuration
# Control where the Flask app loads game data from
# Options: 'csv', 'mongodb', 'auto'
# - 'csv': Load data from CSV files only
# - 'mongodb': Load data from MongoDB only (requires MONGODB_ENABLED=true)
# - 'auto': Try MongoDB first, fallback to CSV if unavailable (default)
# DATA_SOURCE=auto

# MyDevil.net statistics tracking code (optional)
# To enable www statistics in MyDevil panel:
# 1. Log in to your MyDevil.net control panel
# 2. Go to WWW → Statistics
# 3. Enable statistics for your website
# 4. Copy the provided tracking code snippet
# 5. Set MYDEVIL_STATS_CODE to the complete HTML/JavaScript code
# Example: MYDEVIL_STATS_CODE='<script>/* your tracking code here */</script>'
#MYDEVIL_STATS_CODE=

# Admin Authentication (Required for Import/Export features)
# Set a strong password to protect admin features like import and export
# 
# To enable admin authentication:
# 1. Copy this file to .env (the application will automatically load it)
# 2. Uncomment the line below and set your password
# 3. Restart the Flask application
#
# Example: ADMIN_PASSWORD=your-secure-admin-password-here
# If not set, admin authentication will be disabled
#ADMIN_PASSWORD=

# User Authentication (Required for accessing statistics and analysis)
# 
# Option 1: SQLite Database (Recommended for multiple users)
# =========================================================
# The application now supports a SQLite database for managing multiple users (up to 100).
# User credentials and preferences (division, team) are stored securely in the database.
# 
# To use the database:
# 1. Create users using the password generation script:
#    python3 scripts/generate_password.py --create-user <username>
# 2. The script will generate a secure password automatically
# 3. Users can log in with their username and password
# 4. User preferences are automatically saved to the database
#
# Database location: data/users.db (automatically created)
# 
# Option 2: Environment Variables (Legacy, single user only)
# ===========================================================
# Set username and password for the predefined user to access statistics beyond standings and fixtures
# This creates a single user account - credentials should be securely managed
# 
# To enable user authentication:
# 1. Copy this file to .env (the application will automatically load it)
# 2. Uncomment the lines below and set your credentials
# 3. Restart the Flask application
#
# Example: USER_USERNAME=basketballuser
# Example: USER_PASSWORD=your-secure-user-password-here
# If not set, user authentication will use the database
#USER_USERNAME=
#USER_PASSWORD=
