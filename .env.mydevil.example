# MyDevil.net Environment Configuration
# This file contains environment variables for deploying to MyDevil.net hosting
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=production
DEBUG=False

# MongoDB Configuration for MyDevil.net
# MyDevil.net provides MongoDB service accessible via SSH tunnel
MONGODB_ENABLED=true
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=flbb-statistics

# Data Source Configuration
# Use 'auto' to try MongoDB first with CSV fallback for reliability
DATA_SOURCE=auto

# MyDevil.net SSH Tunnel Setup
# MongoDB on MyDevil.net is accessible via SSH tunnel
# 
# Method 1: Manual SSH Tunnel (for testing)
# -----------------------------------------
# Run this command in a separate terminal before starting the Flask app:
#   ssh -L 27017:localhost:27017 your-username@server.mydevil.net
# 
# Replace:
#   - your-username: Your MyDevil.net username
#   - server.mydevil.net: Your specific MyDevil server (e.g., s1.mydevil.net)
#
# Keep this SSH connection open while the Flask app is running
#
# Method 2: AutoSSH (for production - recommended)
# ------------------------------------------------
# Install autossh: sudo apt-get install autossh
# Create systemd service or use screen/tmux to maintain persistent tunnel:
#   autossh -M 0 -f -N -L 27017:localhost:27017 your-username@server.mydevil.net
#
# Method 3: SSH Config with Keep-Alive (alternative)
# --------------------------------------------------
# Add to ~/.ssh/config:
#   Host mydevil-mongodb
#       HostName server.mydevil.net
#       User your-username
#       LocalForward 27017 localhost:27017
#       ServerAliveInterval 60
#       ServerAliveCountMax 3
#
# Then run: ssh -f -N mydevil-mongodb
#
# Important Notes:
# ---------------
# 1. SSH tunnel must be active before starting Flask app
# 2. MongoDB connects to localhost:27017 (tunneled to MyDevil server)
# 3. For production, use autossh or systemd service for reliability
# 4. Test connection: mongosh mongodb://localhost:27017/
# 5. MyDevil.net MongoDB may require authentication - check your panel

# Optional: MongoDB Authentication (if required by MyDevil.net)
# MONGODB_URI=mongodb://username:password@localhost:27017/flbb-statistics
# Replace 'username' and 'password' with your MongoDB credentials from MyDevil panel

# MyDevil.net Statistics Tracking
# Enable website statistics in MyDevil.net control panel
# WWW → Statistics → Copy tracking code
#MYDEVIL_STATS_CODE='<script>/* your tracking code */</script>'

# Google Drive Integration (Optional)
#GOOGLE_DRIVE_CREDENTIALS=path/to/service-account.json
#GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
